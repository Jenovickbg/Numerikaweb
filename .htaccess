# Apache uniquement — non utilisé sur le VPS Nginx Hostinger.
# Conservé pour hébergements Apache éventuels.
# En production Nginx, utiliser : deploy/nginx.conf

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^accueil/?$ accueil.html [L]
</IfModule>
